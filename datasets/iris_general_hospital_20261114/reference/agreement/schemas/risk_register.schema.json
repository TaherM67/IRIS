            "enum": [
              "Unauthorized Access",
              "Reconnaissance",
              "Malware Execution",
              "Privilege Escalation",
              "Web Application Compromise",
              "Data Exfiltration"
            ]
          },
          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Pre-decision likelihood from this historical risk version; never a model output."
          },
          "impact": {
            "type": "integer",

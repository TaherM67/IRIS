{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iris-expanded-input-v1/risk_register.schema.json",
  "title": "Risk Register",
  "type": "object",
  "description": "risk_register.json; retain historical snapshots and pre-decision context.",
  "properties": {
    "schema_version": {
      "const": "iris-risk-register-v1"
    },
    "data_provenance": {
      "const": "synthetic"
    },
    "control_membership_basis": {
      "type": "string",
      "const": "versioned_runtime_risk_snapshots",
      "description": "Membership and implementation state belong to the stated historical risk version."
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One historical registered-risk snapshot, owned by one asset.",
        "properties": {
          "risk_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque stable identifier. Never encode a class, true label or target.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "risk_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque stable identifier. Never encode a class, true label or target.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Opaque stable identifier. Never encode a class, true label or target.",

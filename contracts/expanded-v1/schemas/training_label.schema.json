    },
    "control_reviewer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    }
  },
  "required": [
    "case_id",
    "event_ids",
    "campaign_id",
    "run_id",
    "template_group",
    "scenario_class",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline training annotation",
  "description": "Offline only. LLM generation must leave verification false and reviewers null.",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      }
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "template_group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "scenario_class": {
      "type": "string",
      "enum": [
        "benign",
        "credential_access",
        "reconnaissance",
        "malicious_execution",
        "privilege_escalation",
        "web_exploitation",
        "data_exfiltration"
      ]
    },
    "label_source": {
      "type": "string",
      "enum": [
        "llm_synthetic",
        "deterministic_synthetic_generator"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "independently_reviewed"
      ]
    },
    "label_verified": {
      "type": "boolean"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 120
    },
    "recommended_control_ids": {
      "type": "array",
      "maxItems": 120,
      "uniqueItems": true,
      "items": {
        "type": "string",
